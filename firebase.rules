rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /family_boards/{document=**} {
      // Allow read/write only if the authenticated user's email matches the family list
      allow read, write: if request.auth != null && 
        (request.auth.token.email == "davidgill01@gmail.com" || 
         request.auth.token.email == "lucasrgill01@gmail.com");
    }
  }
}
